#!/bin/bash

# Deployment Script - Interactive Guide
# Based on DEPLOYMENT_GUIDE.md

set -e

# Source nvm if available (for Node.js/pnpm availability)
if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
    source "$HOME/.nvm/nvm.sh"
fi

# Colors for better readability
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
print_step() {
    echo -e "\n${BLUE}===== STEP $1: $2 =====${NC}"
}

print_info() {
    echo -e "${YELLOW}ℹ️  $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_warning() {
    echo -e "${RED}⚠️  $1${NC}"
}

confirm() {
    while true; do
        read -p "$(echo -e ${GREEN}Have you completed this step? Type 'yes' to continue: ${NC})" response
        case $response in
        "yes") return 0 ;;
        *) echo "Please type 'yes' to continue or Ctrl+C to exit." ;;
        esac
    done
}

wait_for_enter() {
    echo -e "${YELLOW}Press Enter to continue...${NC}"
    read
}

echo -e "${BLUE}"
echo "╔════════════════════════════════════════════════════════════════╗"
echo "║                    DEPLOYMENT GUIDE SCRIPT                    ║"
echo "║                                                                ║"
echo "║  This script will guide you through the deployment process    ║"
echo "║  for the weight-training app to preview and production.       ║"
echo "╚════════════════════════════════════════════════════════════════╝"
echo -e "${NC}"

# Find the git repository root and change to it
if git rev-parse --git-dir >/dev/null 2>&1; then
    REPO_ROOT=$(git rev-parse --show-toplevel)
    if [[ "$PWD" != "$REPO_ROOT" ]]; then
        print_info "Changing to repository root: $REPO_ROOT"
        cd "$REPO_ROOT"
    fi
else
    print_warning "This script must be run from within a git repository."
    exit 1
fi

print_info "Starting deployment process..."
wait_for_enter

# Step 1: Switch to nextjs-main and pull
print_step "1" "Switch to nextjs-main branch and pull latest changes"
print_info "Automatically switching to nextjs-main and pulling latest changes..."

if git switch nextjs-main; then
    print_success "Switched to nextjs-main branch"
else
    print_warning "Failed to switch to nextjs-main branch"
    exit 1
fi

if git pull; then
    print_success "Pulled latest changes"
else
    print_warning "Failed to pull latest changes"
    exit 1
fi

print_success "Branch switched and updated!"

# Step 2: Apply database migrations to preview
print_step "2" "Apply database migrations to preview environment"
print_info "Automatically applying database migrations to preview..."

if ./scripts/push-supabase-preview; then
    print_success "Database migrations applied to preview!"
else
    print_warning "Failed to apply database migrations to preview"
    exit 1
fi

# Step 3: Test preview environment
print_step "3" "Test the preview environment"
print_info "About to open the preview environment in your browser..."
print_info "URL: https://weight-training-preview.vercel.app"
wait_for_enter

open https://weight-training-preview.vercel.app
echo ""
print_info "Thoroughly test all new functionality and ensure everything works as expected."
print_info "Check that database changes are working correctly."

if ! confirm; then
    echo "Please fix any issues before proceeding to production deployment."
    exit 1
fi

print_success "Preview environment tested and working!"

# Step 4: Promote to production
print_step "4" "Promote deployment to production"
print_info "In Vercel, you will need to:"
print_info "1. Find the deployment that went into the nextjs-main branch"
print_info "2. Click the '...' menu and select 'Promote to Production'"
print_info "3. Wait for the build to complete"
echo ""
print_info "About to open Vercel deployments page in your browser..."
print_info "URL: https://vercel.com/matt-hamricks-projects/weight-training/deployments"
wait_for_enter

open https://vercel.com/matt-hamricks-projects/weight-training/deployments
echo ""
print_info "This will start a production build. Wait for it to complete before proceeding."

if ! confirm; then
    echo "Please complete the promotion to production before continuing."
    exit 1
fi

print_success "Deployment promoted to production!"

# Step 5: Apply database migrations to production
print_step "5" "Apply database migrations to production"
print_warning "IMPORTANT: Consider the order of steps 4 and 5 based on your database migrations."
print_warning "Use your judgment to determine if migrations should be applied before or after promotion."
echo ""
print_info "Copying production migration command to clipboard..."
echo "./scripts/push-supabase-production" | pbcopy
print_success "Command copied to clipboard: ./scripts/push-supabase-production"
echo ""
print_info "Run the command above when you think it's appropriate for your specific deployment."
print_info "You can paste it with Cmd+V"

if ! confirm; then
    echo "Please apply database migrations to production when appropriate."
    exit 1
fi

# Step 6: Final verification
print_step "6" "Final verification"
print_info "About to open the production environment in your browser..."
print_info "URL: https://weight-training.vercel.app"
wait_for_enter

open https://weight-training.vercel.app
echo ""
print_info "Verify that all features are working correctly in production."
print_info "Check both the application functionality and database operations."

if ! confirm; then
    print_warning "Please investigate and fix any production issues."
    exit 1
fi

# Success!
echo -e "\n${GREEN}"
echo "╔════════════════════════════════════════════════════════════════╗"
echo "║                    🎉 DEPLOYMENT COMPLETE! 🎉                 ║"
echo "║                                                                ║"
echo "║  Your changes have been successfully deployed to production!   ║"
echo "║                                                                ║"
echo "║  Production URL: https://weight-training.vercel.app            ║"
echo "║  Preview URL:    https://weight-training-preview.vercel.app    ║"
echo "╚════════════════════════════════════════════════════════════════╝"
echo -e "${NC}"

print_info "Useful links for monitoring:"
echo "  • Vercel Deployments: https://vercel.com/matt-hamricks-projects/weight-training/deployments"
echo "  • Supabase Preview: https://supabase.com/dashboard/project/leskawvztqgednedbbme"
echo "  • Supabase Production: https://supabase.com/dashboard/project/odjssskczrcunccrwxeh"
